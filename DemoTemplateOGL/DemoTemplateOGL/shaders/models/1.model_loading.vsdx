// ================================
// CONSTANT BUFFERS
// ================================
cbuffer CBPerObject : register(b0)
{
    // ===== MATRICES =====
    float4x4 model;
    float4x4 view;
    float4x4 projection;

    // ===== MATERIAL =====
    float3 materialAmbient;   float pad0;
    float3 materialDiffuse;   float time;
    float3 materialSpecular;  float shininess;

    // ===== LIGHT =====
    float3 lightPosition; float width;
    float3 lightAmbient;  float height;
    float3 lightDiffuse;  float blendFactor;
    float3 lightSpecular; float pad1;
    float3 lightDirection; float pad2;

    // ===== CAMERA / FLAGS =====
    float3 cameraPos;         int textureSample;
    float3 viewPos;           int multipleInstances;
    float3 billboardPos;      int texture_diffuse;
    float3 camRight;          int useBlending;
    float3 color;             int useDynamicLighting;
};

static const int MAX_BONES = 200;
static const int MAX_BONES_INFLUENCE = 4;

cbuffer CBBones : register(b1)
{
    float4x4 finalBonesMatrices[MAX_BONES];
};

// ================================
// INPUT LAYOUT
// ================================
struct VS_INPUT
{
    float3 Position  : POSITION;
    float2 TexCoords : TEXCOORD0;
    float3 Normal    : NORMAL;   // no se usa, pero se mantiene
    float3 tangent    : TANGENT;
    float3 bitangent  : BINORMAL;

    uint4 boneIds     : BLENDINDICES;
    float4 weights    : BLENDWEIGHT;

    // --- Instancing (slot 1) ---
    float3 trans      : TEXCOORD1;
    float3 scale      : TEXCOORD2;
    float  rotX       : TEXCOORD3;
    float  rotY       : TEXCOORD4;
    float  rotZ       : TEXCOORD5;
    float  enabled    : TEXCOORD6;
};

// ================================
// OUTPUT TO PIXEL SHADER
// ================================
struct VS_OUTPUT
{
    float4 Position  : SV_POSITION;
    float2 TexCoords : TEXCOORD0;
};

// ================================
// MAIN
// ================================
VS_OUTPUT main(VS_INPUT input)
{
    VS_OUTPUT output;

    float4 worldPos = mul(float4(input.Position, 1.0f), model);
    float4 viewPos  = mul(worldPos, view);
    output.Position = mul(viewPos, projection);

    output.TexCoords = input.TexCoords;

    return output;
}
