// ================================
// TEXTURE & SAMPLER
// ================================
Texture2D texture_diffuse1  : register(t0);
Texture2D texture_specular1 : register(t1);
Texture2D texture_normal1   : register(t2);
Texture2D texture_height1   : register(t3);
SamplerState samplerLinear  : register(s0);
SamplerState samplerAlpha   : register(s1);

// ================================
// CONSTANT BUFFERS
// ================================
cbuffer CBPerObject : register(b0)
{
    // ===== MATRICES =====
    float4x4 model;
    float4x4 view;
    float4x4 projection;

    // ===== MATERIAL =====
    float3 materialAmbient;   float pad0;
    float3 materialDiffuse;   float time;
    float3 materialSpecular;  float shininess;

    // ===== LIGHT =====
    float3 lightPosition; float width;
    float3 lightAmbient;  float height;
    float3 lightDiffuse;  float blendFactor;
    float3 lightSpecular; float pad1;
    float3 lightDirection; float pad2;

    // ===== CAMERA / FLAGS =====
    float3 cameraPos;         int textureSample;
    float3 viewPos;           int multipleInstances;
    float3 billboardPos;      int texture_diffuse;
    float3 camRight;          int useBlending;
    float3 color;             int useDynamicLighting;
};

// ================================
// INPUT
// ================================
struct PS_INPUT
{
    float4 Position : SV_POSITION;
    float3 FragPos  : TEXCOORD0;
    float2 TexCoords: TEXCOORD1;
    float3 Normal   : TEXCOORD2;
};

// ================================
// MAIN
// ================================
float4 main(PS_INPUT input) : SV_TARGET
{
    // Normal
    float3 norm = normalize(input.Normal);

    float3 lightToFrag = normalize(input.FragPos - lightPosition);

    // =========================
    // Diffuse
    // =========================
    float diff = max(dot(norm, lightToFrag), 0.0f);

    // =========================
    // Specular
    // =========================
    float3 viewDir = normalize(viewPos - input.FragPos);
    float3 reflectDir = reflect(-lightToFrag, norm);
    float spec = pow(max(dot(viewDir, reflectDir), 0.0f), shininess);

    // =========================
    // Attenuation
    // =========================
    float distance = length(input.FragPos - lightPosition);
    float attenuation = 1.0f /
        (1.0f + 0.09f * distance + 0.032f * distance * distance);

    // =========================
    // Spotlight intensity
    // =========================
    float3 lightDir = normalize(lightDirection);

    float theta = dot(lightToFrag, lightDir);
    float epsilon = cos(radians(12.5f)) - cos(radians(5.5f));
    float intensity = saturate((theta - cos(radians(5.5f))) / epsilon);

    // =========================
    // Lighting components
    // =========================
    float3 ambient  = lightAmbient  * materialAmbient;
    float3 diffuse  = lightDiffuse  * diff * materialDiffuse;
    float3 specular = lightSpecular * spec * materialSpecular;

    ambient  *= attenuation;
    diffuse  *= intensity * attenuation;
    specular *= intensity * attenuation;

    float3 result = ambient + diffuse + specular;

    // =========================
    // Texture
    // =========================
    if (textureSample == 1)
    {
        float4 texColor = texture_diffuse1.Sample(samplerLinear, input.TexCoords);
        if (texColor.a < 0.1f)
            discard;

        return float4(result, 1.0f) * texColor;
    }

    return float4(result, 1.0f);
}